      "address": "products.case.feature.@tc-01",
      "path": "testcase/SauceDemo/products.case.feature",
      "tag": "@tc-01",
      "attributes": {
        "localHash": "85cf1a9b1707232bbed3a98a1ead4fdf289baafde3b37b6eab99117e5934da4b",
