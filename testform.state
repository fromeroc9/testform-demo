  "resources": [
    {
      "type": "testcase",
      "identity": "testcase/ParaBank/account_services.case.feature.@tc-01",
      "attributes": {
        "localHash": "982f5622efc2bcd85b9b568da7bdff2dd029f07edda2dde999efec8f219a74b4",
        "remoteId": "local:15",
        "issueNumber": 15,
        "title": "Abrir una nueva cuenta bancaria",
        "body": "```gherkin\nGiven el usuario ha iniciado sesión en ParaBank\nWhen el usuario hace clic en el enlace \"Open New Account\"\nAnd selecciona el tipo de cuenta \"SAVINGS\"\nAnd selecciona una cuenta existente para transferir los fondos iniciales\nAnd hace clic en el botón \"Open New Account\"\nThen el sistema muestra el mensaje \"Account Opened!\"\nAnd genera un nuevo número de cuenta válido\n```",
        "labels": [
          "testcase"
        ],
        "assignees": [
          "fromeroc9"
        ],
        "createdAt": "2026-11-05T04:41:05.775Z",
        "updatedAt": "2026-11-05T04:41:05.775Z",
        "custom_fields": {
