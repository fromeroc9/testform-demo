    {
      "type": "testcase",
      "address": "transactions.case.feature.@tc-01",
      "path": "testcase/ParaBank/transactions.case.feature",
      "tag": "@tc-01",
      "attributes": {
        "localHash": "faaae76baa348fe6b375511f6472b6d95d71f1adb98f9bf0d0881401b7676e93",
