    {
      "type": "testcase",
      "address": "SauceDemo/checkout.case.feature.@tc-01",
      "path": "testcase/SauceDemo/checkout.case.feature",
      "tag": "@tc-01",
      "attributes": {
        "localHash": "9879fb8de0f53d7d56c16cd7ada64f3cef05d0c0bded1f466f0fac07ef4959e0",
